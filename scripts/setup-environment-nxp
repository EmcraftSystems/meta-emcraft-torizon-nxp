#!/bin/sh
#
# Create or enter a build directory for imx6sx-slx-som in a tree made from
# Toradex's NXP manifest (common-torizon/nxp/integration.xml), with this layer
# cloned into sources/:
#
#   source sources/meta-emcraft-torizon-nxp/scripts/setup-environment-nxp [BUILDDIR]
#
# Torizon's setup-environment accepts only the machines it lists, so this runs
# the i.MX set-up it uses for imx6sxsabresd, then adds this layer.
#
# Copyright (C) 2026 Emcraft Systems
# SPDX-License-Identifier: MIT

MACHINE=imx6sx-slx-som
_TDX_DISTRO_SELECT=common-torizon
EULA=1
unset DISTRO
export MACHINE EULA

. sources/meta-toradex-torizon/scripts/lib/setup-devices/setup-environment-imx "${1:-build-imx6sx-slx-som}"

if ! grep -q 'sources/meta-emcraft-torizon-nxp"' conf/bblayers.conf; then
    echo 'BBLAYERS += "${BSPDIR}/sources/meta-emcraft-torizon-nxp"' >> conf/bblayers.conf
fi
