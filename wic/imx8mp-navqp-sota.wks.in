# short-description: Create SD card / EMMC image with ostree boot partition
# long-description:
# Create an image that can be written onto a SD card using dd for use
# with i.MX SoC family
# It uses u-boot + other binaries gathered together on imx-boot file
#
# The disk layout used is:
#  - ---------- -------------- 
# | | imx-boot |     ostree   |
#  - ---------- -------------- 
# ^ ^          ^              ^
# | |          |              |
# 0 |        16M              |
#   |                         |
#   |                       16M + BOOT_PARTITION_SIZE
#   ${IMX_BOOT_SEEK} 32 or 33kiB, see reference manual

part u-boot --source rawcopy --sourceparams="file=imx-boot" --ondisk mmcblk --no-table --align ${IMX_BOOT_SEEK}
part / --source otaimage --ondisk mmcblk1 --fstype=ext4 --part-name otaroot --align 16384

bootloader --ptable gpt
